" GVim loads settings in this order (condensed from `:help gui-init`):
" 1. ALL non-GUI settings (see ~/.vim/vimrc)
" 2. System GUI configs
" 3. $GVIMINIT (as an Ex command line) or ~/.vim/gvimrc
" 4. (only if 'exrc' is set) $PWD/.gvimrc

set columns=84 lines=50
if exists('+guioptions')
    set guioptions=acegirL
endif

if exists('+guiheadroom')
    set guiheadroom=64
endif

if exists('+renderoptions')
    set renderoptions=type:directx,gamma:1.0,contrast:0.5,level:1,geom:1,renmode:4,taamode:1
endif

" Set the font I want to use.
" NB: Some GUIs will let you `set guifont=*` to get a font chooser.
" Windows NeoVide can't find the font if it has "Medium" on the end
"let s:fontface='Iosevka Fixed Medium'
let s:fontface='Iosevka Fixed'
let s:fontsize=11

if exists(':GuiFont')
    " nvim-qt does its own thing
    exec 'GuiFont' substitute(s:fontface, ' ', '\ ', 'g') .. ':h' .. s:fontsize
    "let g:dap='Did it with :GuiFont'
elseif exists("g:neovide")
    " neovide is remarkably picky about its font syntax,
    " so the catch-all below causes it to generate an error
    let &guifont=s:fontface .. ':h' .. s:fontsize
    "let g:dap='Did it with neovide &guifont'
elseif has("gui_win32")
    " this is the format found in `set guifont?` after using `set guifont=*`
    let &guifont=substitute(s:fontface, ' ', '_', 'g') .. ':h' .. s:fontsize .. ':W500:cDEFAULT:qDEFAULT'
    "let g:dap='Did it with gui_win32 &guifont'
else
    " Shotgun approach I was using before, just pile things together
    " and hope the client takes the first one that works.
    " Old versions of neovide didn't support that, and even modern
    " nvim-qt gives an error about fonts it's skipping that don't work.
    "set guifont=Iosevka\ Fixed\ Medium\ 11,Iosevka_Fixed_Medium:h11:cANSI:qDRAFT
    let &guifont=s:fontface .. ' ' .. s:fontsize .. ',' .. substitute(s:fontface, ' ', '_', 'g') .. ':h' .. s:fontsize .. ':cDEFAULT:qDEFAULT'
    "let g:dap='Fell back with &guifont'
endif

