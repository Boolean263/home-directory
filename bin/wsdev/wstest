#!/bin/bash

: "${BUILDPATH:?BUILDPATH not set}"

. "$HOME/env/path_functions.sh"

usage()
{
    if [ -n "$*" ] ; then
        echo "Error: $*" 1>&2
        echo 1>&2
    fi
    cat 1>&2 <<EOT
Build and test Wireshark. For use with 'git bisect'.

Options:
    -c[ARGS], --clean[=ARGS]    Clean build tree before building
                                (pass ARGS to initial cmake command line)
    -cd                         Clean tree and create a debug build
    -DVAR=VAL, -Ccachefile.txt  Passed to initial cmake command line
    -x, --exitfirst, -v…        Passed to pytest
    -k EXPRESSION               Passed to pytest
EOT
    exit 1
}

DO_RESET=
declare -a MY_CMAKE_ARGS
declare -a MY_WSTEST_ARGS

MY_CMAKE_DEBUG_ARGS=(
    "-DCMAKE_BUILD_TYPE=Debug"
    # Sanitizer tests listed here in their CMakeLists order.
    # Currently all disabled based on msys not liking any of them.
    #"-DENABLE_ASAN=1"          # Address sanitizer checks (heavy impact)
    #"-DENABLE_TSAN=1"          # Thread sanitizer checks
    #"-DENABLE_UBSAN=1"         # Undefined behaviour checks
    #"-DENABLE_LSAN=1"          # Leak sanitizer checks (slight impact)
)

while [ -n "$1" ] ; do
    case "$1" in
        -c|--clean)
            DO_RESET=1
            ;;
        -cd|-dc)
            DO_RESET=1
            MY_CMAKE_ARGS+=( "${MY_CMAKE_DEBUG_ARGS[@]}" )
            ;;
        -d)
            MY_CMAKE_ARGS+=( "${MY_CMAKE_DEBUG_ARGS[@]}" )
            ;;
        -c*)
            DO_RESET=1
            MY_CMAKE_ARGS+=("${1#-c}")
            ;;
        --clean=*)
            DO_RESET=1
            MY_CMAKE_ARGS+=("${1#--clean=}")
            ;;
        -[CD]*)
            MY_CMAKE_ARGS+=("${1}")
            ;;
        -x|--exitfirst|-v*)
            MY_WSTEST_ARGS+=("$1")
            ;;
        -k)
            shift
            MY_WSTEST_ARGS+=("-k" "$1")
            ;;
        --)
            break
            ;;
        -h|--help)
            usage
            ;;
        *)
            usage "Unrecognized options"
            ;;
    esac
    shift
done

set -e

if [ -n "$DO_RESET" ] ; then
    reset_build
fi
if ! [ -d "$BUILDPATH" ] ; then
    cm "${MY_CMAKE_ARGS[@]}"
fi

m

if grep -q '^ENABLE_ASAN:BOOL=1$' "$BUILDPATH/CMakeCache.txt" ; then
    echo "Skipping tests (ASAN output causes failures)"
    exit 1
else
    m --target test-programs
    unset WIRESHARK_LOG_LEVEL WIRESHARK_LOG_DOMAINS
    add_to_path PATH "$WS_BIN_PATH"
    "$HOME/bin/alternate-home.sh" python3 -m pytest "$SRCPATH" "${MY_WSTEST_ARGS[@]}"
fi
