#!/bin/sh
[ -n "$DISPLAY" ] || exit 1
XKBHOME="$HOME/.config/xkb"

if [ -n "$XRDP_SESSION" ] ; then
    # My standard settings seem to mess up XRDP sessions.
    # For now, keep it minimal until I can figure things out.
    setxkbmap \
        -option ctrl:nocaps \
        -option compose:menu
else
    # For a local X session, go hog wild
    xkbcomp -w 1 -I"$XKBHOME" "$XKBHOME/keymap/default" "$DISPLAY"
fi

# fcitx may just die when asked to hup, so restart it
if killall -HUP fcitx fcitx5 ; then
    sleep 2
    if ! pgrep -a fcitx ; then
        FCITX=$(which fcitx fcitx5 2>/dev/null | head -n 1)
        if [ -n "$FCITX" ] ; then
            "$FCITX"
        fi
    fi
fi
