#!/bin/sh
#
# Run a terminal muxer, with a specified session name.
# Launch session-specific configuration for the muxer.
# Currently supports tmux and screen.

set -eu

# Protect against nested sessions
#if [ -n "$TMUX" ] || [ -n "$STY" ] ; then
#    echo "You're already in a session ($TMUX$STY)" 1>&2
#    exit 1
#fi

NAME="${1:-default}"
CHOICES="tmux screen"
# shellcheck disable=SC2086
MUXER="$(which $CHOICES 2>/dev/null | head -n 1)"

if [ -z "$MUXER" ] ; then
    echo "No muxer installed, couldn't find any of: $CHOICES" 1>&2
    exit 1
fi
if [ $# -gt 1 ] ; then
    cat 1>&2 <<EOT
Usage: $(basename "$0") [session-name]
For more complex usage, run $MUXER directly.
EOT
    exit 1
fi

AGENT=
if [ -z "$SSH_AUTH_SOCK" ] && command -v ssh-agent >/dev/null 2>&1 ; then
    AGENT=1
fi

case "$MUXER" in
    */tmux*)
        SESS_PREFIX="$XDG_CONFIG_HOME/tmux/sessions/$NAME"
        ${AGENT:+ssh-agent} "$MUXER" start-server
        if ! "$MUXER" has-session -t "$NAME" >/dev/null 2>&1 ; then
            # Session didn't exist, create it now
            cd ~
            "$MUXER" new-session -d -s "$NAME" -n "$NAME"
            if [ -f "$SESS_PREFIX.conf" ] ; then
                "$MUXER" source-file -t "$NAME" "$SESS_PREFIX.conf"
            elif [ -x "$SESS_PREFIX.sh" ] ; then
                "$MUXER" run-shell -t "$NAME" "$SESS_PREFIX.sh"
            fi
        fi
        if [ -z "$TMUX" ] ; then
            # If we aren't already in a tmux session, attach the new one
            "$MUXER" attach-session -t "$NAME"
        else
            "$MUXER" switch-client -t "$NAME"
        fi
        ;;
    */screen*)
        SESS_PREFIX="$XDG_CONFIG_HOME/screen/sessions/$NAME"
        # Protect against nested sessions
        if [ -n "$STY" ] ; then
            echo "You're already in a session ($STY)" 1>&2
            exit 1
        fi
        if ! "$MUXER" -ls -S "$NAME" >/dev/null 2>&1 ; then
            # Session didn't exist, create it now
            cd ~
            ${AGENT:+ssh-agent} "$MUXER" -S "$NAME" -d -m
            if [ -f "$SESS_PREFIX.screenrc" ] ; then
                "$MUXER" -S "$NAME" -X source "$SESS_PREFIX.screenrc"
            fi
        fi
        "$MUXER" -S "$NAME" -x -RR
        ;;
    *)
        echo "I don't know what to do with '$MUXER'." 1>&2
        exit 1
        ;;
esac
